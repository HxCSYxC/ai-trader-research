# 複製呢個檔做 .env，再自己填入 Alpaca「Paper Trading」嘅 key。
# 本項目只會連模擬盤，就算填咗真錢帳戶嘅 key 都唔會用到真錢（code 寫死 paper=True）。
# 唔好將 .env 傳俾任何人或者 commit 上 git。

# 主帳戶：AI + 動量混合
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# （可選）喺 Alpaca 開多個 paper account，同時測試其他策略
# 動量（冇 ML）
ALPACA_MOM_API_KEY=
ALPACA_MOM_SECRET_KEY=
# 平均買晒（對照組）
ALPACA_EW_API_KEY=
ALPACA_EW_SECRET_KEY=

# 公開 dashboard 嘅密碼（最少 12 個字）
DASHBOARD_PASSWORD=
